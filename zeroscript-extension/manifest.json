{
  "manifest_version": 3,
  "name": "ZeroScript DeepSeek",
  "version": "2.0.0",
  "description": "A DeepSeek-only browser extension that exposes a local MCP tool server through ZeroScript.",
  "permissions": ["storage"],
  "host_permissions": ["https://chat.deepseek.com/*", "https://deepseek.com/*", "http://127.0.0.1/*", "ws://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_title": "ZeroScript DeepSeek", "default_icon": { "16":"icon.png", "48":"icon.png", "128":"icon.png" } },
  "content_scripts": [{ "matches": ["https://chat.deepseek.com/*"], "js": ["core/config.js", "core/parser.js", "providers/deepseek.js", "core/main.js"], "css": ["overlay.css"], "run_at": "document_idle" }]
}
